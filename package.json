{
  "name": "titan-hunter-3d",
  "private": true,
  "version": "1.0.0",
  "description": "High-speed 3D ODM Aerial Action Game built with Three.js, TypeScript, and Rapier 3D",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/index.ts",
    "dev:mp": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate-assets": "node scripts/generate-glb-assets.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.26",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/ws-transport": "^0.18.4",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "colyseus.js": "^0.16.22",
    "three": "^0.170.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
